# Terra Pulse-Dify Integration Configuration
# Copy this file to .env and update with your actual values

# Terra Pulse Configuration
TERRA_PULSE_MODEL_PATH=backend/terra_pulse_model.onnx

# Dify API Configuration (REQUIRED)
DIFY_API_KEY=your_dify_api_key_here
DIFY_API_ENDPOINT=https://api.dify.ai/v1
DIFY_WORKFLOW_ID=your_workflow_id_here

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# API Configuration
MAX_RETRIES=3
TIMEOUT_SECONDS=30

# Security Configuration
API_KEY_HEADER=X-API-Key
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ENFORCE_HTTPS=false

# Logging Configuration
LOG_LEVEL=INFO